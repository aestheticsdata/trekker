#!/usr/bin/env bash
# Refuses a commit that would publish infrastructure (TRE-5 §4).
#
# Install with `pnpm hooks:install`. Hooks are not cloned, so this is opt-in per
# checkout — and with no CI behind it, an uninstalled hook means no guard at all.
# What it buys when it is installed is the whole point: it refuses before the
# commit exists, which is the difference between an edit and the history rewrite
# this repo has already had to perform once.
#
# Two layers, because they fail differently. gitleaks knows entropy and key
# formats; the shapes in infra-patterns.sh know what actually went wrong here —
# a hostname in a comment, which carries no entropy at all and which no generic
# scanner flags. Those run whether or not gitleaks is installed.

set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=.githooks/infra-patterns.sh
. "$here/infra-patterns.sh"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

fail=0

note() {
  printf '\n  \033[31m✗ %s\033[0m\n' "$1" >&2
  fail=1
}

# ---- layer 1: gitleaks, when it is here ------------------------------------

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --config .gitleaks.toml --redact --no-banner --exit-code 1 . >/dev/null 2>&1; then
    note "gitleaks found something in the staged changes."
    gitleaks git --staged --config .gitleaks.toml --redact --no-banner --exit-code 1 . >&2 2>&1 || true
  fi
else
  printf '  gitleaks not installed — running the built-in checks only.\n' >&2
  printf '  brew install gitleaks   (nothing else scans for you)\n' >&2
fi

# ---- layer 2: this repo's own shapes ---------------------------------------
#
# Checked against the staged content, not the working tree, so a `git add -p`
# that stages only part of a file is judged on what it actually stages.
#
# The guard files are excluded because they quote the shapes they match:
# scanning them finds their own rules. That is a real blind spot rather than a
# tidy one — a leak written into one of them is invisible to this layer — so
# they get read by eye, and `pnpm scan` covers them, since gitleaks allowlists
# only .gitleaks.toml and still reads everything under .githooks/.

# `grep -v '^+++ '` drops the diff's own file headers. They are added lines by
# the letter of `^+`, and every path under src/users/ then reads as a home
# directory or a hostname.
diff=$(git diff --cached --unified=0 --diff-filter=ACMR -- . ':!pnpm-lock.yaml' ':!.gitleaks.toml' ':!.githooks/pre-commit' ':!.githooks/commit-msg' ':!.githooks/infra-patterns.sh' | grep '^+' | grep -v '^+++ ' || true)

scan_infra "$diff" || fail=1

# ---- staged filenames ------------------------------------------------------
#
# `ecosystem.config.js` is named exactly, not by extension: it is the one file
# here that holds the master key and the session secret, and it is a .js like
# any other. Spelling it out this way spares ecosystem.config.example.js, which
# ends in example.js rather than config.js, and front/ecosystem.config.cjs,
# which holds nothing and is committed.
#
# `credentials` takes any of the three separators somebody actually types. It
# was written with a dot alone, and a real `credentials-trekker.txt` at the root
# matched neither this list nor .gitignore (TRE-134) — the same hole `prod.env`
# went through before `*.env` replaced `.env.*` in TRE-5. `secrets` keeps its
# dotted form here, in step with .gitignore, where widening it the same way
# would silently ignore every new file in the tracked nest-api/src/secrets/.

blocked=$(printf '%s\n' "$staged" | grep -Ei '(^|/)(\.env($|\..*)|.*\.env|credentials[._-].*|secrets\..*|known_hosts.*|authorized_keys|id_(rsa|dsa|ecdsa|ed25519).*|.*\.(pem|key|p12|pfx|ppk|jks)|\.npmrc|\.pgpass|\.netrc|dump\.(rdb|pm2)|ecosystem\.config\.js)$' | grep -v '\.example$' || true)
if [ -n "$blocked" ]; then
  note "These filenames never belong in this repo:"
  printf '%s\n' "$blocked" | sed 's/^/      /' >&2
fi

if [ "$fail" -ne 0 ]; then
  printf '\n  Commit refused. Fix the lines above, or if it is genuinely a placeholder,\n' >&2
  printf '  commit with --no-verify and say why in the message.\n\n' >&2
  exit 1
fi

exit 0
