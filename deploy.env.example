# Copy to deploy.env and fill in. deploy.env is NOT committed.
#
# The sibling apps hardcode their deploy target inside their deploy scripts, and
# those repos are public too, so the user@host pair is readable by anyone who
# looks — not a vulnerability, but free reconnaissance. Trekker keeps everything
# that names real infrastructure here instead, and the scripts stay generic.
#
# Which is the whole point of this file, so it does not get to be the exception:
# no value below is real. See TRE-5.

# SSH target the deploy runs against, as user@host. Uses your ssh config, so an
# alias defined in ~/.ssh/config is the tidiest value.
TREKKER_DEPLOY_HOST="deploy@host.example.com"

# Base directory on the server. The scripts create, under it:
#   public_html/          the live front
#   nest-api/             the live API
#   *-releases/, *.bak/   release history and the rollback target
#   deploy-logs/          the deploy changelog
TREKKER_REMOTE_ROOT="/var/www/trekker"

# Ports, from the fleet's port registry. Must match ecosystem.config.* on the
# server.
TREKKER_FRONT_PORT="3005"
TREKKER_API_PORT="6800"

# PATH additions needed to reach pnpm and pm2 over a non-interactive SSH session.
# A non-login shell does not source the profile, so these are not on PATH by default.
#
# Write the SERVER's paths out in full, and do not use $HOME. This file is
# sourced by the deploy script on YOUR machine, so a "$HOME" here expands to your
# workstation's home directory and travels to the server as a path that does not
# exist there — silently, since a PATH entry that is not a directory is ignored
# rather than reported. Find the real values with:
#   ssh <your-host> 'which -a node pnpm pm2'
TREKKER_REMOTE_PATH="/home/deploy/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin:/usr/sbin"

# Deploy reporting to the fleet's deploy registry — optional; leave unset if the
# box runs no registry, and deploys then work unreported. These name the two
# files ON THE SERVER holding the ingest URL and the shared token: the
# registry's own pm2 ecosystem file and its .env, read on the box at report time
# so neither value ever travels. The app must exist in the registry or the
# report is refused.
#TREKKER_ZEUS_ECOSYSTEM_FILE="/var/www/<registry-app>/ecosystem.config.js"
#TREKKER_ZEUS_ENV_FILE="/var/www/<registry-app>/nest-api/.env"
# Trekker's slug in the registry. Defaults to "trekker".
#TREKKER_ZEUS_APP_NAME="trekker"

# Both of these are normally passed on the command line for one run rather than
# set here, but the scripts read them, so they belong in the contract.
#
# (There was a TREKKER_ALLOW_DIRTY here, for deploying an uncommitted working
# tree. It was removed: a deploy ships the files on disk but labels the release,
# the server changelog and the deploy report with HEAD, so a dirty deploy names a
# commit that is not what is running. Commit first.)
#
# Where the deploy changelog starts counting from when the previous deploy left
# no marker: a commit-ish the range is computed against.
#TREKKER_SINCE=""
