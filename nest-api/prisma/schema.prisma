// Trekker's data model. See docs/superpowers/specs/2026-08-09-trekker-design.md §6.
//
// Sessions are not here — they live in Redis (TRE-7).
//
// Two rules run through the whole file:
//
//   1. Deleting a host takes everything that only makes sense with it: its
//      credential, its pinned keys, its roots, its bookmarks, its scans. An
//      encrypted credential outliving its host is a secret nobody will ever
//      look at again.
//   2. Deleting a host does NOT take the audit trail. Transfer jobs and
//      activity rows keep their story and null out the reference.
//
// Paths are VarChar(700) wherever they are indexed and Text where they are
// not. InnoDB caps an index at 3072 bytes and utf8mb4 costs 4 bytes a
// character, so an indexed path plus a CHAR(36) key has to stay under that.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------- enums

enum HostTransport {
  LOCAL
  SSH
}

enum CredentialKind {
  PRIVATE_KEY
  PASSWORD
  AGENT
}

enum RootAccess {
  READ
  WRITE
}

/// Who an account is to the install, not what it may do to a given path —
/// that is still the roots' job (TRE-48).
///
/// An enum rather than an `isOwner` boolean because the ticket that introduced
/// it promises a third kind of account. `isOwner: false` is a no-information
/// state every call site would have to reinterpret when that lands; a named
/// role is a fact the next reader can extend.
enum UserRole {
  OWNER
  MEMBER
}

enum TransferOperation {
  COPY
  MOVE
}

enum TransferStatus {
  QUEUED
  RUNNING
  PAUSED
  DONE
  FAILED
  CANCELLED
}

enum TransferItemStatus {
  PENDING
  RUNNING
  DONE
  SKIPPED
  FAILED
}

/// What to do when the destination already exists.
///
/// `ASK` is the initial state and means *undecided* — the plan found nothing at
/// the destination, so nobody was asked anything. TRE-23 settled what happens
/// when an item carrying it turns out to have a conflict after all, which is
/// only possible when the destination changed between planning and running: the
/// item is **skipped and the reason recorded**. It does not stall waiting for an
/// answer. A job that pauses mid-flight for input is a job that sits half-done
/// while nobody is looking at the tab it would have asked in, and the decisions
/// it would ask for were all taken before it started.
///
/// `RESUME` is produced by nothing today. It is the answer for continuing a
/// partially-written file, and TRE-23 writes to a temporary name and renames
/// into place — so there is never a partial file under a real name to resume.
enum ConflictDecision {
  ASK
  OVERWRITE
  SKIP
  RENAME
  RESUME
}

enum ScanStatus {
  RUNNING
  DONE
  FAILED
  /// Stopped by somebody, not by an error. Distinct from FAILED because a
  /// cancelled scan is not a host that misbehaved, and the panel says so
  /// differently (TRE-32).
  CANCELLED
}

/// Which `du` answered, and therefore which facts the scan could gather.
///
/// Stored on the row rather than inferred, because the three facts are
/// independently nullable and "we did not ask" has to be distinguishable from
/// "we asked and this host cannot say". A null largest file on a PORTABLE scan
/// is a BSD `du` with no `--time`; the same null on a GNU scan would be a bug.
enum ScanFlavour {
  /// `du -x -a -0 -B1 --time --time-style=+%s` — every fact.
  GNU
  /// BSD or busybox: `du -x -a -k`. No mtime, so no age fact.
  PORTABLE
  /// No `-a` either: directory subtotals only, so the treemap and nothing else.
  SUBTOTALS
}

/// What a treemap rectangle is. `OTHER` is the synthetic remainder row and has
/// no path on the host — see `DiskScanEntries.kind`.
enum ScanEntryKind {
  DIRECTORY
  FILE
  OTHER
}

/// Which machine read the bytes (TRE-27 §1).
///
/// Stored rather than inferred, because the two are not equivalent work and
/// the difference is worth being able to see afterwards. `REMOTE` is
/// `sha256sum` on the host, which reads the file where it already is.
/// `STREAMED` means the host has no `sha256sum`, so every byte crossed the
/// network into this process to be hashed here — the same digest at a cost
/// that scales with the link rather than with the disk.
enum HashMethod {
  REMOTE
  STREAMED
}

// ---------------------------------------------------------------- account

model Users {
  id                     String   @id @default(uuid(7)) @db.Char(36)
  email                  String   @unique @db.VarChar(255)
  passwordHash           String   @db.VarChar(255)
  /// Set when the user opts into passphrase recovery (TRE-7). Null means they
  /// have no recovery route and a lost password is a manual reset.
  recoveryPassphraseHash String?  @db.VarChar(255)

  /// The install's owner browses without the roots allowlist binding them
  /// (TRE-48). MEMBER is every other account and is bound by it in full.
  ///
  /// The default is the point. A creation path that never thought about
  /// privilege produces a bound account, so the failure direction is always a
  /// refusal and never an opening.
  role UserRole @default(MEMBER)

  /// An install has at most one owner. The same trick as `Hosts.localSlot`:
  /// MySQL has no partial unique index, so OWNER rows set this to `true` and
  /// MEMBER rows leave it NULL — a unique index counts every NULL as distinct,
  /// so only a second owner collides.
  ///
  /// It exists because deciding the owner means counting the accounts and then
  /// creating one, and two registrations can both read zero. Granting
  /// unrestricted filesystem access on a race is not a thing to leave to
  /// timing, so the database refuses the second one.
  ownerSlot Boolean? @unique

  /// Where this account was when it last had the explorer open, so a bare URL
  /// reopens it (TRE-51). A footprint, not a saved view: `Views` holds the
  /// named, deliberate ones, and a reserved row in that table would have to be
  /// filtered out of the strip, the sidebar, the shortcut check and every
  /// rename or delete path — one hidden row every future query has to remember
  /// to exclude.
  ///
  /// Json because the shape belongs to the front and will move with it; nothing
  /// queries into it. Null means the account has never had a layout worth
  /// reopening, which is what a new account gets.
  lastLayout Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hosts        Hosts[]
  views        Views[]
  transferJobs TransferJobs[]
  activity     ActivityLog[]
}

// ---------------------------------------------------------------- hosts

model Hosts {
  id        String        @id @default(uuid(7)) @db.Char(36)
  userId    String        @db.Char(36)
  /// Stable handle used in URLs and saved views, so renaming the label does
  /// not break a bookmarked link.
  slug      String        @db.VarChar(64)
  label     String        @db.VarChar(64)
  transport HostTransport
  /// Null for LOCAL: there is nothing to dial.
  address   String?       @db.VarChar(255)
  port      Int           @default(22)
  username  String?       @db.VarChar(64)
  /// Accent colour for the pane header and the host chip, as a hex string.
  colour    String        @default("#7fa8c9") @db.VarChar(16)
  homePath  String        @default("/") @db.VarChar(700)

  /// A user may have at most one LOCAL host. MySQL has no partial unique
  /// index, so LOCAL rows set this to `true` and SSH rows leave it NULL — a
  /// unique index counts every NULL as distinct, so only a second LOCAL row
  /// collides. The hosts service is the only writer and sets it from
  /// `transport`; the constraint is what makes a concurrent double-create
  /// fail rather than race.
  localSlot Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         Users            @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential   HostCredentials?
  knownKeys    HostKnownKeys[]
  roots        HostRoots[]
  bookmarks    Bookmarks[]
  diskScans    DiskScans[]
  fileHashes   FileHashes[]
  transfersOut TransferJobs[]   @relation("TransferSource")
  transfersIn  TransferJobs[]   @relation("TransferDestination")
  activity     ActivityLog[]

  @@unique([userId, slug])
  @@unique([userId, localSlot])
}

/// One credential per host — a host authenticates one way. There is no
/// plaintext column, not even a nullable one: the absence of the column is the
/// guarantee. TRE-8 owns how the ciphertext is produced.
model HostCredentials {
  id     String         @id @default(uuid(7)) @db.Char(36)
  hostId String         @unique @db.Char(36)
  kind   CredentialKind

  /// AES-256-GCM. The IV and tag are fixed-width on purpose: a wrong-sized
  /// value is a bug, and the column refuses it instead of failing at decrypt.
  ciphertext Bytes @db.Blob
  iv         Bytes @db.Binary(12)
  authTag    Bytes @db.Binary(16)

  /// Which master key encrypted this row. Rotation rewrites rows one version
  /// at a time and can tell what it has already done.
  keyVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host Hosts @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

/// Host key pinning, trust on first use. The fingerprint is compared before
/// any credential is offered (TRE-10).
model HostKnownKeys {
  id          String    @id @default(uuid(7)) @db.Char(36)
  hostId      String    @db.Char(36)
  algorithm   String    @db.VarChar(32)
  fingerprint String    @db.VarChar(128)
  firstSeenAt DateTime  @default(now())
  /// Set when the user confirmed the fingerprint out of band. Null means it
  /// was accepted on first sight and never checked against anything.
  verifiedAt  DateTime?

  host Hosts @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([hostId, algorithm])
}

/// The allowlist. Nothing outside these roots is reachable, whatever path the
/// request asks for (TRE-11).
model HostRoots {
  id     String     @id @default(uuid(7)) @db.Char(36)
  hostId String     @db.Char(36)
  path   String     @db.VarChar(700)
  access RootAccess @default(READ)

  host Hosts @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([hostId, path])
}

model Bookmarks {
  id       String  @id @default(uuid(7)) @db.Char(36)
  hostId   String  @db.Char(36)
  path     String  @db.VarChar(700)
  label    String  @db.VarChar(64)
  /// The small grey line under the label in the sidebar.
  hint     String? @db.VarChar(128)
  position Int     @default(0)

  host Hosts @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([hostId, path])
  @@index([hostId, position])
}

// ---------------------------------------------------------------- layout

/// A saved layout. The mockup keeps these in localStorage, which loses them
/// per browser; they belong to the account (TRE-37).
///
/// The columns this shipped with described a layout this app never had — a
/// `split` percentage and a separate `solo` pane, written before TRE-18 settled
/// what the URL actually carries, which is one three-valued `split` and no
/// percentage at all. Six columns were replaced by one `layout` blob in TRE-37,
/// and the reason is not brevity: the front already has exactly one description
/// of a layout and exactly one canonical serialisation of it, and the dirty dot
/// is a string comparison against that serialisation. Columns in a second
/// vocabulary would be a translation, and a translation is where the dot starts
/// lying about whether anything changed.
model Views {
  id     String @id @default(uuid(7)) @db.Char(36)
  userId String @db.Char(36)
  name   String @db.VarChar(64)

  /// Which of `⌥1`–`⌥9` restores this, or null for none. Unique per user.
  ///
  /// The digit, not the string "⌥3". How a chord is spelled belongs to the
  /// front's keymap — one table, read from everywhere (TRE-36) — and moving a
  /// glyph there must not be a migration here.
  slot Int?

  /// Both panes, the split, the inspector, the heat map and the glob, in the
  /// front's own `ViewLayout` shape. Json for the reason `Users.lastLayout` is:
  /// the shape belongs to the front and will move with it, and nothing queries
  /// into it.
  layout Json

  /// Host id to the label that host had when this view was saved.
  ///
  /// A memo, and deliberately not part of `layout`: it is never compared, so
  /// renaming a host cannot make a view look unsaved. It exists for one
  /// sentence — a view whose host has since been deleted has to be able to say
  /// *which* machine is gone, and the id alone cannot, because the row it named
  /// is the row that no longer exists.
  hostLabels Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@unique([userId, slot])
}

// ---------------------------------------------------------------- transfers

model TransferJobs {
  id     String @id @default(uuid(7)) @db.Char(36)
  userId String @db.Char(36)

  /// Nullable and set null on host deletion: the record of a transfer outlives
  /// the host it touched.
  srcHostId String? @db.Char(36)
  srcPath   String  @db.Text
  dstHostId String? @db.Char(36)
  dstPath   String  @db.Text

  operation TransferOperation
  /// Per-job switches — preserve timestamps, follow symlinks, and so on.
  options   Json?
  status    TransferStatus    @default(QUEUED)

  bytesTotal BigInt @default(0)
  bytesDone  BigInt @default(0)

  /// Item counts, carried on the job rather than counted from `TransferItems`.
  /// The progress feed emits several times a second per running job and a
  /// `COUNT(*) ... GROUP BY status` over ten thousand rows for each tick is a
  /// query nobody needs to run: these two numbers are what the bar is drawn
  /// from, and the rows are what explains them afterwards.
  itemsTotal Int @default(0)
  itemsDone  Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  error      String?   @db.Text
  createdAt  DateTime  @default(now())

  user    Users  @relation(fields: [userId], references: [id], onDelete: Cascade)
  srcHost Hosts? @relation("TransferSource", fields: [srcHostId], references: [id], onDelete: SetNull)
  dstHost Hosts? @relation("TransferDestination", fields: [dstHostId], references: [id], onDelete: SetNull)

  items TransferItems[]

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
}

/// One entry of a transfer, walked before the job starts and never re-walked.
///
/// These rows are the plan, not a log of it. Everything the runner needs to
/// place an entry at the destination is here — what it is, how big, what mode
/// and mtime to stamp on it, what to do if something is already in the way — so
/// an API restart resumes from the table rather than walking the source again
/// (TRE-23 §1). A re-walk would also be a different tree: the point of deciding
/// the conflicts up front is that the set does not change underneath.
model TransferItems {
  id     String @id @default(uuid(7)) @db.Char(36)
  jobId  String @db.Char(36)
  /// Path relative to the job's source, so the destination can be rebuilt.
  name   String @db.VarChar(700)
  bytes  BigInt @default(0)

  /// `file`, `directory` or `symlink`, from the walk. The runner branches on it
  /// three ways and none of them is the default, so it is not nullable.
  kind String @db.VarChar(16)
  /// Permission bits and modification time to stamp on the copy, captured by
  /// the walk that produced this row. Nullable because the walk records what it
  /// saw, and an entry it could not stat contributes no bits rather than zeroes
  /// — a copy made 0o000 by a stat that failed is worse than one left default.
  mode    Int?
  mtimeMs BigInt?

  conflict ConflictDecision   @default(ASK)
  status   TransferItemStatus @default(PENDING)
  /// What it ended up called, when that is not `name` — a `keepBoth` decision
  /// lands as `report (2).txt`, and a UI that did not say so leaves somebody
  /// looking for a file that is right there under a name they never chose.
  finalName String? @db.VarChar(700)
  error     String? @db.Text

  job TransferJobs @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
}

// ---------------------------------------------------------------- disk

/// One `du` of one root, kept so the treemap survives a reload (TRE-32).
///
/// The row is written twice and no more: once as RUNNING when the scan is
/// accepted, once when it ends. Nothing is written per record — a walk emits
/// millions of them — and the entries below land in the same transaction as
/// the terminal write, so a scan has either all of its rows or none of them at
/// every instant, including a `kill -9`. A RUNNING scan carrying a partial
/// entry set is exactly the "partial scan marked complete" the ticket forbids,
/// and this shape makes it unrepresentable rather than merely unlikely.
model DiskScans {
  id     String @id @default(uuid(7)) @db.Char(36)
  hostId String @db.Char(36)
  root   String @db.VarChar(700)

  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  totalBytes BigInt?
  inodes     BigInt?
  status     ScanStatus @default(RUNNING)

  /// How deep the persisted tree goes — what is *stored*, never what is read.
  ///
  /// The walk is always full depth, and the reason is that `du --max-depth`
  /// limits printing rather than walking: `du` stats every inode either way, so
  /// a depth limit on the wire buys no IO back. What it would cost is the three
  /// facts, which come from the per-file records `-a` prints and which a depth
  /// limit truncates. So depth is applied here, by the aggregator, to one full
  /// walk (TRE-32 §1).
  depth Int @default(3) @db.TinyInt

  /// "One scan per host at a time", as a promise the database keeps.
  ///
  /// Holds the hostId while RUNNING and NULL afterwards. MySQL has no partial
  /// unique index, so this is the same trick `Users.ownerSlot` and
  /// `Hosts.localSlot` use — a unique index counts every NULL as distinct, so
  /// only a second *running* scan of one host collides.
  ///
  /// A field on a service would have been simpler and wrong twice over: it
  /// cannot survive a restart, and a check-then-insert across two Node ticks is
  /// a race that starts two `du`s on somebody's server. It is also what makes
  /// the boot sweep obligatory rather than tidy — a RUNNING row left by a crash
  /// holds this key and locks the host out of scanning until something nulls it.
  runningSlot String? @unique @db.Char(36)

  /// The scan this one replaces, kept until this one reaches DONE so the panel
  /// never goes blank mid-scan.
  ///
  /// A relation rather than a `SUPERSEDED` status: a superseded scan is still
  /// DONE and still entirely servable, which is the whole point of keeping it.
  /// A status would make every read path ask "DONE or SUPERSEDED?" and the
  /// answer would always be yes.
  ///
  /// `SetNull`, never `Cascade`: deleting the old scan must not delete the new
  /// one that points at it — which is precisely what the terminal transaction
  /// does on success.
  supersedesId String?    @unique @db.Char(36)
  supersedes   DiskScans? @relation("Superseded", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy DiskScans? @relation("Superseded")

  /// Which `du` answered, so a fact reported as unavailable is explained rather
  /// than looking like a bug.
  flavour ScanFlavour @default(GNU)
  /// Whether the walk actually ran de-prioritised. False when the host has no
  /// `nice` and the scan was retried without it — worth saying, because it is
  /// the difference between a considerate scan and a rude one.
  niced   Boolean     @default(true)

  /// Directories `du` could not read, counted from its stderr. A count and not
  /// the messages: remote text is never persisted, and the number is what tells
  /// somebody the total is short.
  unreadableCount Int @default(0)
  /// Set when one of the aggregator's bounds bit, so a tree that is not the
  /// whole tree never presents itself as one.
  truncated       Boolean @default(false)

  /// Why it failed, in fixed English chosen here from the error's class. Never
  /// the remote message, which is somebody else's machine talking.
  error String? @db.VarChar(500)

  // ---- the three facts. NULL is "not gathered", and never zero: a host whose
  // `du` cannot report mtimes has no age answer, which is a different statement
  // from "no files here are old".

  largestPath  String? @db.Text
  largestBytes BigInt?

  oldFileCount BigInt?
  oldFileBytes BigInt?
  /// The cutoff the count was taken against, stored rather than recomputed on
  /// read: "older than a year" has to keep meaning a year before *this* scan,
  /// not a year before whenever somebody opens the panel.
  oldFileBefore DateTime?

  /// Groups sharing a size, groups a hash then confirmed, and groups the bounds
  /// left unhashed. All three are reported: "12 confirmed" alone would read as
  /// the whole answer when it is the part we could afford to check.
  dupGroupsCandidate  Int?
  dupGroupsConfirmed  Int?
  dupGroupsSkipped    Int?
  /// Each confirmed group's size counted once less than its member count —
  /// what deleting the copies would give back, keeping one of each.
  dupReclaimableBytes BigInt?

  host    Hosts             @relation(fields: [hostId], references: [id], onDelete: Cascade)
  entries DiskScanEntries[]

  @@index([hostId, startedAt(sort: Desc)])
  /// The GET's index: the most recent scan of one root. The index above cannot
  /// serve it — `root` is not a prefix of it — and the panel asks this question
  /// on every load. Prefixed at 191 characters because InnoDB caps a key at
  /// 3072 bytes and utf8mb4 spends 4 per character.
  @@index([hostId, root(length: 191), startedAt(sort: Desc)])
}

/// One rectangle of the treemap.
///
/// These are not every directory the walk saw — they are the top few consumers
/// per level down to `DiskScans.depth`, plus one synthetic `OTHER` row per
/// parent holding everything else. The aggregation is server-side by design:
/// the client draws what it is given and never sums anything, so two clients
/// cannot disagree about what a level adds up to.
model DiskScanEntries {
  id     String @id @default(uuid(7)) @db.Char(36)
  scanId String @db.Char(36)
  path   String @db.Text
  bytes  BigInt
  /// Share of the scan root, for the label beside the rectangle.
  ///
  /// The *geometry* is drawn from `bytes`, which sum to the parent exactly.
  /// These are rounded per row and therefore need not sum to 100 within a
  /// level, which is correct and should not be "fixed": a percentage is a label
  /// and the bytes are the truth.
  percent Decimal @db.Decimal(5, 2)

  /// The parent's path, so one indexed read returns one whole treemap level.
  ///
  /// Empty string on the root row rather than the root's own path — otherwise
  /// the root is its own child and the level query returns it twice.
  parentPath String @db.VarChar(700)
  /// 0 is the root. Redundant with `parentPath` for the level query, and kept
  /// anyway: it makes "the whole persisted tree, in order" one query, and it
  /// makes the sum-equals-total check cheap enough for a test to make it.
  depth      Int    @db.TinyInt
  kind       ScanEntryKind

  scan DiskScans @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId, bytes(sort: Desc)])
  @@index([scanId, parentPath(length: 191), bytes(sort: Desc)])
}

// ---------------------------------------------------------------- checksums

/// One file's sha256, remembered (TRE-27 §2).
///
/// **These rows are the durable half of a hash job, and the only half.** The
/// job itself lives in this process and nowhere else — no `HashJobs` table, no
/// `runningSlot`, no boot sweep — which is the opposite of what `DiskScans`
/// does and is deliberate. A scan produces one answer at the end, so an
/// interrupted scan has nothing to keep and the row it left behind has to be
/// reaped. A hash job produces one answer *per file*, written here as each
/// file finishes, so a restart halfway through a hundred-file job loses the
/// job and keeps the ninety-one digests it had already earned. There is
/// nothing to reconcile and therefore nothing to sweep; re-queueing the rest
/// is one click and skips everything already cached.
///
/// The same shape is what makes cancelling cheap: stopping a job abandons the
/// files it had not reached and keeps every one it had.
model FileHashes {
  id     String @id @default(uuid(7)) @db.Char(36)
  hostId String @db.Char(36)
  path   String @db.VarChar(700)

  /// A 64-character lowercase hex digest. `Char`, not `VarChar`: sha256 has
  /// exactly one length, and a column that cannot hold anything else is one
  /// fewer thing to validate on the way out.
  digest String @db.Char(64)

  /// The size and mtime the file had **when it was read**, which together are
  /// the cache key's other half.
  ///
  /// A lookup matches on (host, path) and is then only usable if both of these
  /// still agree with a fresh `stat`. That is a cheap, conservative test rather
  /// than a correct one — a file rewritten to the same length within the same
  /// millisecond keeps its old digest — and it is the right trade at this
  /// price: the alternative to a heuristic is re-reading twenty gigabytes to
  /// find out nothing changed. What it must never do is fail the other way, and
  /// it cannot: every ordinary write moves the mtime.
  ///
  /// `BigInt` for the mtime rather than `DateTime`, because it is compared for
  /// equality against `FileStat.mtimeMs` and never rendered. Storing it as a
  /// date would round-trip it through two timezone-aware layers to answer a
  /// question that is exactly "is this the same number".
  size    BigInt
  mtimeMs BigInt

  /// Which machine actually read the bytes. Reported to the client because a
  /// checksum whose provenance is invisible is one nobody can second-guess.
  method HashMethod

  computedAt DateTime @default(now())

  host Hosts @relation(fields: [hostId], references: [id], onDelete: Cascade)

  /// One row per file, replaced when the file changes. Not `(hostId, path,
  /// size, mtimeMs)`: a unique key over all four keeps a row for every version
  /// a file has ever had, and every one of them except the newest is a digest
  /// of bytes that no longer exist anywhere. The stale ones would accumulate
  /// forever behind a lookup that can never return them.
  ///
  /// 36 + 700 characters at 4 bytes each is 2 944, inside InnoDB's 3 072-byte
  /// key — so this one needs no prefix, unlike the scan indexes above.
  @@unique([hostId, path])
  @@index([hostId, computedAt(sort: Desc)])
}

// ---------------------------------------------------------------- audit

/// The outcome of an audited operation.
///
/// `pending` is written BEFORE the handler runs and is the reason this enum
/// exists at all: a row that never left `pending` is an operation that started
/// and did not finish — a crash, a kill, a timeout. Those are precisely the
/// ones worth having a record of, and a log written only on success cannot
/// have one (TRE-30 §1).
enum AuditOutcome {
  pending
  success
  failure
  /// Stopped before it ran: a rate limit, a rejected path, a missing token.
  /// Distinct from `failure`, which means it ran and did not work.
  refused
}

/// The audit trail and the activity strip are the same rows: an action worth
/// showing the user is an action worth recording. TRE-30 owns the vocabulary
/// of `kind`, which is a string rather than an enum because it gains a value
/// with nearly every feature and a migration per value is not worth it.
///
/// Append-only from the application's side. Exactly two writes touch a row —
/// the interceptor's pre-write and its outcome update — and only the prune job
/// deletes. Nothing else may update or delete, and `audit-coverage.spec.ts`
/// holds that line.
///
/// The job is the unit, never the item: a transfer of ten thousand files is
/// one row here and ten thousand in `TransferItems`. A log that grows with the
/// work instead of with the decisions stops being readable exactly when it
/// matters (TRE-30 §2).
model ActivityLog {
  id      String  @id @default(uuid(7)) @db.Char(36)
  userId  String  @db.Char(36)
  hostId  String? @db.Char(36)
  kind    String  @db.VarChar(32)
  summary String  @db.VarChar(255)
  /// Short badge shown on the strip — "3 files", "412 MB".
  tag     String? @db.VarChar(32)
  payload Json?

  /// Which session acted. A stolen session is the thing you reconstruct from
  /// this table, and a user id cannot separate one login from another.
  /// Nullable because the pre-session routes (register, recover) have none.
  sessionId String? @db.VarChar(128)

  outcome AuditOutcome @default(pending)
  /// Why it failed or was refused, for the operator reading the strip. Never a
  /// stack trace and never a credential — see `redact.ts`.
  detail  String?      @db.VarChar(255)

  /// Ran with elevated privileges (TRE-29). Its own column rather than a
  /// payload key: "what did this session do as root" is a question worth an
  /// index, not a JSON scan.
  elevated Boolean @default(false)

  /// Where in the UI the action was started from — `terminal` (TRE-35), or null
  /// for the buttons, which are the default and need no marking.
  ///
  /// Its own column for the same reason `elevated` has one, and it is the same
  /// question one step along: "what did this session do as root" and "what did
  /// this session type rather than click" are both things you ask of a whole
  /// history at once, and a JSON scan over `payload` is not how you ask them.
  ///
  /// Not `tag`, which is already spoken for — that is the badge on the strip,
  /// and it carries counts, sizes and transports. A column that sometimes means
  /// "3 files" and sometimes means "terminal" cannot be filtered on.
  ///
  /// Client-supplied, and therefore never trusted as a claim about privilege:
  /// it says which surface a request came from, and the surfaces have exactly
  /// the same permissions. A forged value moves nothing but a label. It is
  /// still validated against a closed list, because an audit column is a
  /// terrible place to let a client write free text.
  origin String? @db.VarChar(16)

  /// Destroyed or moved data, or granted privilege. Copied onto the row from
  /// the route's `@Audited` spec rather than derived from `kind` at prune
  /// time: the prune job runs months later, and a `kind` renamed or retired in
  /// between would silently reclassify old rows into the short retention
  /// window — deleting exactly the history worth keeping.
  destructive Boolean @default(false)
  /// Bytes moved, where the operation moves bytes. BigInt because a transfer
  /// outgrows a 32-bit count and the overflow would be silent.
  bytes    BigInt?

  durationMs Int?

  createdAt DateTime @default(now())

  user Users  @relation(fields: [userId], references: [id], onDelete: Cascade)
  host Hosts? @relation(fields: [hostId], references: [id], onDelete: SetNull)

  permissionSnapshots PermissionSnapshots[]

  /// Cursor pagination orders by `id`, not `createdAt`: the id is a uuid v7,
  /// so it is already time-ordered, unique, and immune to two rows sharing a
  /// millisecond — which a createdAt cursor is not, and which loses rows
  /// silently at the page boundary rather than loudly.
  @@index([userId, createdAt(sort: Desc)])
  /// The unfiltered page, which is what the sidebar strip asks for on every
  /// load. Ordering by `id` after filtering on `userId` alone cannot use the
  /// composite indexes below — MySQL will not skip a middle column to satisfy
  /// an ORDER BY — so without this the commonest query in the app filesorts.
  @@index([userId, id(sort: Desc)])
  @@index([userId, kind, id(sort: Desc)])
  @@index([userId, hostId, id(sort: Desc)])
  @@index([outcome, id])
  /// The prune job's only query: everything of one class older than a date.
  @@index([destructive, createdAt])
}

/// Old mode/uid/gid for one entry, before a chmod or chown changed it
/// (TRE-75). Written only for entries the operation actually changed — the
/// walk (or a single `stat` for a non-recursive change) already has these
/// values in hand, so this is never a second fetch.
///
/// `path` is `Text`, unindexed: every lookup is by `activityLogId`, never by
/// path, matching `DiskScanEntries.path`.
///
/// Pruned on its own 30-day schedule by `RetentionService`, independent of
/// `ActivityLog`'s own 90/365-day retention — the audit summary line should
/// outlive the ability to undo it. `onDelete: Cascade` is a referential
/// backstop only, for the (normally never reached) case an `ActivityLog`
/// row is deleted before its own snapshots have aged out; it is not the
/// prune mechanism.
model PermissionSnapshots {
  id            String   @id @default(uuid(7)) @db.Char(36)
  activityLogId String   @db.Char(36)
  path          String   @db.Text
  mode          Int
  uid           Int
  gid           Int
  createdAt     DateTime @default(now())

  activityLog ActivityLog @relation(fields: [activityLogId], references: [id], onDelete: Cascade)

  @@index([activityLogId])
  @@index([createdAt])
}
