# Copy to .env and fill in. .env is never committed — this repo is public (TRE-5).
# Every variable here is required by src/config/env.validation.ts: the API
# refuses to boot if one is missing or malformed, rather than failing later.

# Port the API listens on. Allocated from the Zeus port registry, which is the
# authoritative source: API block 6800-6899 for Trekker, front on 3005.
# Never pick a port here without claiming it in Zeus first.
PORT=6800

# MySQL / MariaDB connection. Used by the health check now, by Prisma from TRE-6.
DATABASE_URL="mysql://trekker:change-me@127.0.0.1:3306/trekker"

# Redis, for sessions (TRE-7) and job state.
REDIS_URL="redis://127.0.0.1:6379"

# Origin allowed by CORS, and the only origin that may send credentials.
FRONTEND_URL="http://localhost:3005"

# Session signing secret. Generate with: openssl rand -base64 48
# Never reuse the value below.
SESSION_SECRET="replace-me-with-a-long-random-string"

# Added by later tickets, listed so the shape is visible:
#   TREKKER_MASTER_KEY          TRE-8  — decrypts every stored SSH credential.
#                                        Must live outside every allowed root.
#   TREKKER_DOWNLOAD_LINK_KEY   TRE-26 — signs expiring download links.
#                                        A separate key on purpose.
