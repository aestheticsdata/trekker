{
  "name": "trekker-api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "verify:secrets": "tsx scripts/verify-secret-store.ts",
    "verify:drivers": "tsx scripts/verify-drivers.ts",
    "verify:ssh": "tsx scripts/verify-ssh-driver.ts",
    "verify:fs": "tsx scripts/verify-fs-listing.ts",
    "verify:disks": "tsx scripts/verify-disks.ts",
    "verify:scan": "tsx scripts/verify-scan.ts",
    "verify:hash": "tsx scripts/verify-hash.ts",
    "account:create": "tsx scripts/create-account.ts",
    "host:create": "tsx scripts/create-host.ts",
    "rotate-key": "tsx scripts/rotate-master-key.ts",
    "dev": "NODE_ENV=development nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/src/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test,prisma,scripts}/**/*.ts\" prisma.config.ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:db": "NODE_OPTIONS='--experimental-vm-modules' jest --config ./test/jest-db.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "connect-redis": "^10.0.0",
    "express-session": "^1.19.0",
    "mariadb": "^3.4.5",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ssh2": "^1.17.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/ssh2": "^1.15.5",
    "@types/supertest": "^6.0.2",
    "@types/yazl": "^3.3.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@audit/(.*)$": "<rootDir>/audit/$1",
      "^@bookmarks/(.*)$": "<rootDir>/bookmarks/$1",
      "^@compare/(.*)$": "<rootDir>/compare/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@redis/(redis\\..*)$": "<rootDir>/redis/$1",
      "^@database/(.*)$": "<rootDir>/database/$1",
      "^@fs/(.*)$": "<rootDir>/fs/$1",
      "^@hashes/(.*)$": "<rootDir>/hashes/$1",
      "^@health/(.*)$": "<rootDir>/health/$1",
      "^@hosts/(.*)$": "<rootDir>/hosts/$1",
      "^@scans/(.*)$": "<rootDir>/scans/$1",
      "^@secrets/(.*)$": "<rootDir>/secrets/$1",
      "^@transfers/(.*)$": "<rootDir>/transfers/$1",
      "^@users/(.*)$": "<rootDir>/users/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
