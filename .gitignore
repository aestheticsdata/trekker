# Trekker is a public repo and holds SSH credentials at runtime.
# Nothing environment-specific ever gets committed. See TRE-5.

# dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/

# There are no .env files in this project — configuration lives in
# ecosystem.config.js on both sides. These stay as a backstop so one can never
# be added by accident.
.env
.env.*

# Deploy target: names the real host and paths. deploy.env.example is tracked.
deploy.env

# The API's PM2 config holds production secrets. Only the .example is tracked.
# The front's config has none, so front/ecosystem.config.cjs IS committed.
nest-api/ecosystem.config.js

# secrets and key material
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts
*.gpg

# build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# runtime
dump.rdb
*.log
npm-debug.log*
pnpm-debug.log*

# testing
coverage/
test-results/
playwright-report/
e2e/.auth/

# generated
generated/

# editors and OS
.DS_Store
.idea/
.vscode/
.claude/worktrees/

credentials.txt
