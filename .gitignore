# Trekker is a public repo and holds SSH credentials at runtime.
# Nothing environment-specific ever gets committed. See TRE-5.

# dependencies
node_modules/
.pnp
.pnp.js
.pnpm-store/

# There are no .env files in this project — configuration lives in
# ecosystem.config.js on both sides. These stay as a backstop so one can never
# be added by accident.
#
# `.env.*` only catches a *suffix*, so `prod.env` and `secrets.env` walked
# straight past it until TRE-5's audit; `*.env` is the rule that matters. The
# `!` lines are what keeps the tracked templates tracked.
.env
.env.*
*.env
!*.env.example

# Deploy target: names the real host and paths. deploy.env.example is tracked.
deploy.env

# The API's PM2 config holds production secrets. Only the .example is tracked.
# Unanchored, so a copy at the root or in front/ is caught too — the old rule
# named one path and missed both. front/ecosystem.config.cjs is a .cjs and holds
# no secrets, so it stays committed.
ecosystem.config.js
!ecosystem.config.example.js

# secrets and key material
*.pem
*.key
*.p12
*.pfx
*.ppk
*.jks
*.keystore
id_rsa*
id_dsa*
id_ed25519*
id_ecdsa*
known_hosts*
authorized_keys*
.ssh/
*.gpg
*.asc

# credentials by any other name. Unanchored: the root is where they usually get
# dropped, but front/ and nest-api/ are where you are standing when you drop
# one, and the root-anchored rule ignored both.
credentials.*
secrets.*
.npmrc
.pgpass
.netrc

# database dumps — never *.sql, which would swallow prisma/migrations
*.dump
*-backup.sql
dump.sql

# build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# runtime
dump.rdb
dump.pm2
*.log
npm-debug.log*
pnpm-debug.log*

# testing
coverage/
test-results/
playwright-report/
e2e/.auth/

# generated
generated/
# Written and re-added by `next dev` (Next 16), not by anyone working here —
# see node_modules/next/dist/server/lib/generate-agent-files.js. Ignored rather
# than committed: they are the framework's notes to an agent, they come back on
# their own after every `pnpm dev`, and this repo keeps its instructions in
# CLAUDE.md at the root.
front/AGENTS.md
front/CLAUDE.md

# editors and OS
.DS_Store
.idea/
.vscode/
.claude/worktrees/
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
