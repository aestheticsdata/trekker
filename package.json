{
  "name": "trekker",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./front\" --filter \"./nest-api\" dev",
    "build": "pnpm --filter \"./nest-api\" build && pnpm --filter \"./front\" build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3"
  }
}
